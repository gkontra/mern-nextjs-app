# ------------------------------------------------------------------
# mearn-nextjs-app – Repository-weite Ignore-Regeln
# (frontend/.gitignore gilt zusätzlich für den Frontend-Ordner)
# ------------------------------------------------------------------

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Abhängigkeiten, Builds, Logs
node_modules/
dist/
*.log

# Umgebungsvariablen (nur die *-example-Dateien werden geteilt)
.env
.env.*
!.env-example
!.env.example

# ------------------------------------------------------------------
# KI- und Agenten-Konfiguration – gehört nicht ins Kurs-Repository
# Die Dateien bleiben lokal liegen und funktionieren weiter;
# sie werden nur nicht versioniert bzw. weitergegeben.
# ------------------------------------------------------------------

# Claude Code: Skills, Settings, Projekt-Memory
.claude/
CLAUDE.md
CLAUDE.local.md

# Agenten-Anweisungen (gelten für mehrere Tools)
AGENTS.md
AGENTS.override.md
.agents/

# Arbeitsberichte der Agenten
docs/reports/

# Weitere KI-Tools
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.codex/
.gemini/
GEMINI.md
